# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_datadance?schema=public"

# JWT 密钥
JWT_SECRET="your-secret-key"
JWT_EXPIRES_IN="7d"

# 服务器配置
PORT=8080
NODE_ENV="development"
# 反向代理跳数（Express trust proxy）：限流与日志按 X-Forwarded-For 里的真实客户端 IP 计；直连时设 0
# 默认 2 = 生产链路 Cloudflare → nginx → 容器。上线前必须用一次真实请求核对 req.ip 是否等于
# 终端用户地址：少算一跳会让同一 Cloudflare PoP 后面的所有用户共用一个限流桶，多算一跳会让
# X-Forwarded-For 可伪造。
TRUST_PROXY_HOPS=1
# 日志级别 error | warn | info | debug
LOG_LEVEL="info"

# API Base URL (使用 ngrok 提供的 URL)
API_BASE_URL="https://35ed-154-29-144-72.ngrok-free.app"

# Connect AI / MCP OAuth (issuer = API origin; consent page = Wallet origin)
# PUBLIC_BASE_URL 是必填项：它就是 OAuth issuer 和所有令牌的受众。已删除“从 X-Forwarded-Host /
# Host 推导”的回退——那等于让请求方决定我们的身份标识。未设置时相关端点直接抛错。
PUBLIC_BASE_URL="https://api.datadance.ai"
APP_PUBLIC_URL="https://app.datadance.ai"
FRONTEND_URL="https://app.datadance.ai"
# 公共客户端动态注册开关（MCP：POST /oauth/register 与 CIMD 客户端元数据抓取）。默认 true，保持
# 今天的 ChatGPT / Claude 行为；活动窗口设为 false，两条路径一律 403，期间不会冒出新的客户端。
OAUTH_PUBLIC_REGISTRATION_ENABLED="true"
# /oauth/token 按客户端的上限（次/分钟），只对通过校验的机密客户端（合作方）计数；默认 3000。
# 假设：活动峰值 ≤ 约 50 次登录/秒（= 3000/分钟）。这是防失控循环的保险丝，不是安全控制；
# 未认证 / 密钥错误的请求仍按 IP 限流（20/分钟），合作方的正常换码不再占用它服务器 IP 的额度。
# Per-client ceiling for VERIFIED confidential clients at /oauth/token, and (in its own bucket) at
# /oauth/revoke. Assumption: campaign peak <= ~50 logins/s. It catches runaway loops; it is not a
# security control. /oauth/revoke 同样：合作方已认证的撤销不按 IP 计，只受这个上限（单独计数）。
OAUTH_TOKEN_CLIENT_MAX_PER_MIN="3000"

# Default invoice seller when an order has no merchant
INVOICE_SELLER_USER_ID=""
INVOICE_SELLER_EMAIL=""
INVOICE_SELLER_TAX_ID=""
INVOICE_SELLER_ADDRESS=""

# Apple Push Notification Service
APNS_KEY_ID="QW9B77ZUW9"
APNS_TEAM_ID="R2DAZ94F4S" 
# Web3Auth ID token verification (SSO P0). See README "Web3Auth ID token verification".
# off = legacy client-asserted login only (dev only; refused at boot when NODE_ENV=production)
# log = verify when the Wallet sends idToken; a REJECTED token is refused exactly as under enforce.
#       A request with no idToken is refused too unless WEB3AUTH_ALLOW_LEGACY_FALLBACK=true.
# enforce = idToken required; identity only from the verified token (production target)
WEB3AUTH_VERIFY_MODE="log"
# Web3Auth project client id = expected token audience. Required unless WEB3AUTH_VERIFY_MODE=off.
WEB3AUTH_CLIENT_ID=""
# Accepted login connections (csv), matched against the verifier claim the token carries
# (aggregateVerifier / verifier / groupedAuthConnectionId / authConnectionId). REQUIRED when
# WEB3AUTH_VERIFY_MODE=enforce — boot refuses an empty list, because empty means "any connection
# in our Web3Auth project", and whoever can add one there (a console credential, a hijacked
# dashboard session) can then pick any verifierId and become any user. A token whose verifier is
# not listed is 401 IDTOKEN_VERIFIER_NOT_ALLOWED under enforce, accepted-but-logged under log.
# Include "external-wallet" if sign-in-with-wallet is offered; the list also gates every lazy
# link into an existing account, the wallet-proven one included.
WEB3AUTH_ALLOWED_VERIFIERS=""
# Social / e-mail logins: JWKS and accepted issuers (csv)
WEB3AUTH_JWKS_URL="https://api-auth.web3auth.io/jwks"
WEB3AUTH_ISSUERS="https://api-auth.web3auth.io"
# External wallets (sign-in-with-wallet): JWKS, accepted issuers (csv), audience (csv; empty = WEB3AUTH_CLIENT_ID)
WEB3AUTH_EXTERNAL_JWKS_URL="https://authjs.web3auth.io/jwks"
WEB3AUTH_EXTERNAL_ISSUERS="https://authjs.web3auth.io"
WEB3AUTH_EXTERNAL_AUDIENCE=""
# Signing-key pins (hardening G4). A valid signature only proves "signed by a key the JWKS URL
# served"; whoever can influence that response can serve a key of their own (even under the real
# key's kid). The key that verified each token is identified by its RFC 7638 SHA-256 thumbprint
# (43 base64url chars, computed from the key, never from kid) and checked against this csv.
# ONE list covers both JWKS sets above. Read the current values — public, no login needed — with
#   node scripts/web3authJwksThumbprints.js
# and CHECK each key before pinning (README "Web3Auth signing-key pins" runbook). Pin the current
# AND the next key whenever Web3Auth publishes the next one. Malformed entries refuse boot.
WEB3AUTH_JWKS_PINNED_THUMBPRINTS=""
# off     = no check
# log     = accept, but warn `jwks_key_not_pinned` {kid, thumbprint, jwksUrl} (default; rollout)
# enforce = 401 IDTOKEN_KEY_NOT_PINNED, logged at error level with the same fields. Requires a
#           non-empty list (boot refuses otherwise). REQUIRED when SSO_TGE_ENABLED=true.
#           Integrity over availability, deliberately: when Web3Auth rotates to a key that is not
#           pinned, EVERY login fails until the operator verifies it, adds its pin and restarts.
WEB3AUTH_JWKS_PIN_MODE="log"
# Accepted JWS algorithms (csv) and maximum token age (jose duration, e.g. 1d, 12h)
WEB3AUTH_ALGS="ES256"
WEB3AUTH_MAX_TOKEN_AGE="1d"
# Claim paths (csv, first present wins; dot paths allowed). v9 names first, v10 names as fallback.
WEB3AUTH_VERIFIER_CLAIM="aggregateVerifier,verifier,groupedAuthConnectionId,authConnectionId"
WEB3AUTH_VERIFIER_ID_CLAIM="verifierId,userId"
WEB3AUTH_EMAIL_CLAIM="email"
# Claim (dot path) carrying the IdP's own "I verified this address" flag. Only a real boolean
# true counts; without it the e-mail is never used to find an existing account.
WEB3AUTH_EMAIL_VERIFIED_CLAIM="email_verified"
WEB3AUTH_WALLETS_CLAIM="wallets"
# How the claimed wallet is checked against the token: public_key (derive address from
# wallets[].public_key, also accepts wallets[].address), address (wallets[].address only), none (never bind from token)
WEB3AUTH_WALLET_MATCH="public_key"
# Verifier names allowed to lazily link a legacy `web3auth` row by the e-mail the token asserts (csv).
# EMPTY = NEVER link by e-mail (opt-in only, by name). Even when allow-listed, an IdP-asserted
# e-mail also needs WEB3AUTH_EMAIL_VERIFIED_CLAIM === true, an unlinked non-organization
# `web3auth` row, and no wallet mismatch. Linking by a wallet the token PROVES needs none of this.
WEB3AUTH_LEGACY_VERIFIERS=""
# `log` mode only: may a request that sends NO idToken still log in with the body-asserted
# identity (e-mail / wallet / xid)? false = no; that is the historical takeover path. Turn it on
# only for the rollout window, watch the `legacy_login` log count, then turn it off and go enforce.
WEB3AUTH_ALLOW_LEGACY_FALLBACK="false"

# Partner (TGE) SSO — static confidential OAuth client, configured here only (never in the DB).
# Generate SSO_TGE_CLIENT_SECRET_SHA256 with: node scripts/genPartnerSecret.js
# See docs/TGE_SSO.md. Test and prod deployments carry DIFFERENT client ids, hashes and redirect URIs.
SSO_ENVIRONMENT="test"                       # test | prod (required when SSO_TGE_ENABLED=true)
SSO_TGE_ENABLED="false"                      # kill switch; false → /oauth/token and /partner/tge/* refuse the client
SSO_TGE_CLIENT_ID="tge-test"                 # [A-Za-z0-9._-]{1,64}
SSO_TGE_CLIENT_NAME="DDC TGE"
SSO_TGE_CLIENT_SECRET_SHA256=""              # 64-hex sha256 of the secret handed to the partner
SSO_TGE_CLIENT_SECRET_SHA256_PREVIOUS=""     # rotation: old hash, accepted until ROTATION_UNTIL
SSO_TGE_SECRET_ROTATION_UNTIL=""             # ISO-8601, e.g. 2026-10-01T00:00:00Z
SSO_TGE_REDIRECT_URIS="https://tge.example.com/oauth/callback"   # csv, exact match; https only (http for localhost outside prod)
SSO_TGE_INITIATE_LOGIN_URI=""                # Phase 3 App hand-off target; required for /api/sso/* (no URI → CLIENT_DISABLED)
SSO_TGE_STATUS_FIELDS="registered_at,wallet_bound,data_licence_granted"   # frozen /partner/tge fields; unset → nothing is served
# The per-field freeze list above is the second gate on every optional field; the first is the
# scope the user granted. Both must be open. Candidates, and what each one costs the user:
#   registered_at, wallet_bound, data_licence_granted   scope tge:status    — on by default above
#   email_masked                                        scope tge:identity  — j***@domain.com display hint
#   email                                               scope tge:email     — the REAL address
#   wallet_address                                      scope tge:wallet    — the bound address, EIP-55
#   points                                              scope tge:points    — live balance, never cacheable
#   referral                                            scope tge:referral  — own code, inviter id, direct-invitee COUNT
#   referral_network                                    scope tge:referral_network — GET /partner/tge/referral-network:
#                                                       every upline and downline id at any depth (404 not_available if unlisted)
# email, wallet_address, points, referral and referral_network are OFF until listed here: a deploy alone exposes
# nothing new. A field that is not listed is absent from the body, not null.
SSO_REQUIRE_VERIFIED_SESSION="false"         # true → partner consent needs a DDC JWT with ver>=2 (P0 verified login)

# Phase 3 App->browser hand-off (/api/sso/app-ticket, /api/sso/ticket/exchange).
# SSO_SESSION_SECRET signs the consent-only SSO session. It MUST differ from JWT_SECRET:
# that difference is what keeps the session out of every other authenticated endpoint
# (`protect` verifies against JWT_SECRET and rejects it). Boot fails when SSO_TGE_ENABLED=true
# and the secret is missing or equal to JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SSO_SESSION_SECRET=""                        # dedicated HS256 key for the 5-minute SSO session
SSO_TICKET_TTL_SEC="60"                      # hand-off ticket lifetime (contract: 60)
SSO_SESSION_TTL_SEC="300"                    # SSO session lifetime (contract: 300)

# Money-path boot assertions. SSO_TGE_ENABLED=true is the switch that puts DataDance identities
# in front of the partner page, so from that moment the container REFUSES TO START unless:
#   NODE_ENV=production, WEB3AUTH_VERIFY_MODE=enforce, WEB3AUTH_ALLOW_LEGACY_FALLBACK=false,
#   WEB3AUTH_CLIENT_ID and WEB3AUTH_ALLOWED_VERIFIERS non-empty, WEB3AUTH_JWKS_PIN_MODE=enforce
#   with a non-empty, well-formed WEB3AUTH_JWKS_PINNED_THUMBPRINTS, SSO_SESSION_SECRET set and
#   different from JWT_SECRET, PUBLIC_BASE_URL and APP_PUBLIC_URL set and https.
# There is no variable to switch that off: turn SSO_TGE_ENABLED off instead. The boot log prints
# a summary of the values (never the secrets; the pins only as a count). See README "Partner SSO
# boot assertions".
#
# Authorization-request ↔ browser binding has no switch either: GET /oauth/authorize always sets
# the `__Host-ddc_authz` cookie and POST /api/oauth/consent always requires it back, so a consent
# link that is forwarded to another browser can never mint a code. The Wallet consent page MUST
# send the request with credentials (`fetch(..., { credentials: 'include' })`) or every approval
# answers 409 AUTHZ_INITIATOR_MISMATCH.
