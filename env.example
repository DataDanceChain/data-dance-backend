# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_datadance?schema=public"

# JWT 密钥
JWT_SECRET="your-secret-key"
JWT_EXPIRES_IN="7d"

# 服务器配置
PORT=8080
NODE_ENV="development"
# 反向代理跳数（Express trust proxy）：限流与日志按 X-Forwarded-For 里的真实客户端 IP 计；直连时设 0
# 默认 2 = 生产链路 Cloudflare → nginx → 容器。上线前必须用一次真实请求核对 req.ip 是否等于
# 终端用户地址：少算一跳会让同一 Cloudflare PoP 后面的所有用户共用一个限流桶，多算一跳会让
# X-Forwarded-For 可伪造。
TRUST_PROXY_HOPS=1
# 日志级别 error | warn | info | debug
LOG_LEVEL="info"

# API Base URL (使用 ngrok 提供的 URL)
API_BASE_URL="https://35ed-154-29-144-72.ngrok-free.app"

# Connect AI / MCP OAuth (issuer = API origin; consent page = Wallet origin)
# PUBLIC_BASE_URL 是必填项：它就是 OAuth issuer 和所有令牌的受众。已删除“从 X-Forwarded-Host /
# Host 推导”的回退——那等于让请求方决定我们的身份标识。未设置时相关端点直接抛错。
PUBLIC_BASE_URL="https://api.datadance.ai"
APP_PUBLIC_URL="https://app.datadance.ai"
FRONTEND_URL="https://app.datadance.ai"
# 绑定 X 账号（决策 46）：X 回调后浏览器回到哪里。只由配置决定，请求里的任何地址都不采用。
# 都可不填：web 默认 ${APP_PUBLIC_URL}/user/my；iOS 默认 datadance://localhost/user/my；
# Android 默认 ai.datadance.app://localhost/user/my。X_OAUTH_CALLBACK_URL（在 X 后台登记的回调）不变。
# X_BIND_RETURN_URL_WEB=""
# X_BIND_RETURN_URL_IOS=""
# X_BIND_RETURN_URL_ANDROID=""
# 公共客户端动态注册开关（MCP：POST /oauth/register 与 CIMD 客户端元数据抓取）。默认 true，保持
# 今天的 ChatGPT / Claude 行为；活动窗口设为 false，两条路径一律 403，期间不会冒出新的客户端。
OAUTH_PUBLIC_REGISTRATION_ENABLED="true"
# /oauth/token 按客户端的上限（次/分钟），只对通过校验的机密客户端（合作方）计数；默认 3000。
# 假设：活动峰值 ≤ 约 50 次登录/秒（= 3000/分钟）。这是防失控循环的保险丝，不是安全控制；
# 未认证 / 密钥错误的请求仍按 IP 限流（20/分钟），合作方的正常换码不再占用它服务器 IP 的额度。
# Per-client ceiling for VERIFIED confidential clients at /oauth/token, and (in its own bucket) at
# /oauth/revoke. Assumption: campaign peak <= ~50 logins/s. It catches runaway loops; it is not a
# security control. /oauth/revoke 同样：合作方已认证的撤销不按 IP 计，只受这个上限（单独计数）。
OAUTH_TOKEN_CLIENT_MAX_PER_MIN="3000"

# Default invoice seller when an order has no merchant
INVOICE_SELLER_USER_ID=""
INVOICE_SELLER_EMAIL=""
INVOICE_SELLER_TAX_ID=""
INVOICE_SELLER_ADDRESS=""

# Apple Push Notification Service
APNS_KEY_ID="QW9B77ZUW9"
APNS_TEAM_ID="R2DAZ94F4S" 

# On-chain signer and chain settings (src/constants/chainConfig.js, used by src/utils/web3Utils.js).
# CHAIN_SIGNER_PRIVATE_KEY signs the transactions the API sends itself. It is also the fallback signer
# for commerce attestation when BACKEND_WALLET_PRIVATE_KEY is unset, and that code takes its RPC from
# DDC_RPC_URL (below): on a laptop leave this EMPTY unless DDC_RPC_URL points at a local node too.
# 64 hex characters, optional 0x prefix. NO default and no key in the repository: set it in the server
# environment only, one key per environment (test and prod never share one), never commit or log it.
# Unset or malformed: the API still boots, logs ONE warning naming the variable, and every signing
# call fails with an error naming it; the rest of the API is unaffected.
CHAIN_SIGNER_PRIVATE_KEY=""
# Which chain. CHAIN_RPC_URL / CHAIN_ID are read first, then DDC_RPC_URL / DDC_CHAIN_ID (the pair the
# commerce attestation, DDC NFT metadata and balance code read, so one setting moves them all), then
# the production default: the shared DataDance test chain dev-exp-alpha, 44508. NODE_ENV plays no
# part. Set a pair in full, the URL and the id together. An invalid value is a boot warning and every
# chain call then fails naming the variable. The RPC URL appears in ethers' own error messages, and
# some handlers return error.message in their 500 response, so it must NEVER carry a credential: no
# user:password@, no API key in the path or the query.
# A local run points at a local node, not at the shared test chain (from the dockerised API use
# http://host.docker.internal:8545):
CHAIN_RPC_URL="http://localhost:8545"
CHAIN_ID="31337"
# The shared test chain is what you get when none of the four variables is set. Deployments only:
# CHAIN_RPC_URL="https://dev-exp-alpha.datadance.ai/eth/rpc"
# CHAIN_ID="44508"
# DDC_RPC_URL=""   # the pair the other chain readers use; CHAIN_RPC_URL / CHAIN_ID fall back to it
# DDC_CHAIN_ID=""

# POST /api/activities/new (create an activity and its NFT contract; src/constants/activityNftFeature.js).
# Default off: the endpoint answers 503 {"success":false,"code":"ACTIVITY_NFT_UNAVAILABLE",...} before
# any chain or database work and before an upload is stored. Only "true" (any case) turns it on, and
# on does NOT make it work yet: the chain code still refuses with the same 503 and logs why (no
# activity NFT factory with a verified interface exists). Re-enabling needs a new factory with a
# verified ABI and a new owner key, then the code change described in src/utils/web3Utils.js.
ACTIVITY_NFT_ENABLED="false"

# App version policy: GET /api/app/version-policy (public, no auth) tells the App the lowest version
# it may run, so an older App can show "update required". APP_MIN_VERSION_* are dotted numbers (2.1.0,
# 2 to 4 parts); unset or blank = null = the App never blocks anyone. A value that is not a version
# is ignored (treated as unset) with one boot warning. Update links must be https.
# APP_STORE_URL_IOS defaults to our App Store listing. APP_DOWNLOAD_URL_ANDROID has NO default: the
# downloads directory (https://app.datadance.ai/downloads/) answers 403, so set it to the APK file,
# whose name carries the version, or to a page that offers it. An Android minimum without a usable
# download URL is ignored (minVersion null) with one boot warning naming both variables, because an
# update prompt needs somewhere to send the user.
APP_MIN_VERSION_IOS=""
APP_MIN_VERSION_ANDROID=""
APP_STORE_URL_IOS="https://apps.apple.com/app/id6743675282"
APP_DOWNLOAD_URL_ANDROID=""

# Web3Auth ID token verification (SSO P0). See README "Web3Auth ID token verification".
# off = legacy client-asserted login only (dev only; refused at boot when NODE_ENV=production)
# log = verify when the Wallet sends idToken; a REJECTED token is refused exactly as under enforce.
#       A request with no idToken is refused too unless WEB3AUTH_ALLOW_LEGACY_FALLBACK=true.
# enforce = idToken required; identity only from the verified token (production target)
WEB3AUTH_VERIFY_MODE="log"
# Web3Auth project client id = expected token audience. Required unless WEB3AUTH_VERIFY_MODE=off.
# Devnet and Sapphire Mainnet are different projects. The live wallet API keeps the Devnet
# client id. staging.env.example and tge.env.example each get their own, and neither is this file.
WEB3AUTH_CLIENT_ID=""
# Accepted login connections (csv), matched against the verifier claim the token carries
# (aggregateVerifier / verifier / groupedAuthConnectionId / authConnectionId). REQUIRED when
# WEB3AUTH_VERIFY_MODE=enforce — boot refuses an empty list, because empty means "any connection
# in our Web3Auth project", and whoever can add one there (a console credential, a hijacked
# dashboard session) can then pick any verifierId and become any user. A token whose verifier is
# not listed is 401 IDTOKEN_VERIFIER_NOT_ALLOWED under enforce, accepted-but-logged under log.
# Include "external-wallet" if sign-in-with-wallet is offered; the list also gates every lazy
# link into an existing account, the wallet-proven one included.
WEB3AUTH_ALLOWED_VERIFIERS=""
# Social / e-mail logins: JWKS and accepted issuers (csv)
WEB3AUTH_JWKS_URL="https://api-auth.web3auth.io/jwks"
WEB3AUTH_ISSUERS="https://api-auth.web3auth.io"
# External wallets (sign-in-with-wallet): JWKS, accepted issuers (csv), audience (csv; empty = WEB3AUTH_CLIENT_ID)
WEB3AUTH_EXTERNAL_JWKS_URL="https://authjs.web3auth.io/jwks"
WEB3AUTH_EXTERNAL_ISSUERS="https://authjs.web3auth.io"
WEB3AUTH_EXTERNAL_AUDIENCE=""
# Signing-key pins (hardening G4). A valid signature only proves "signed by a key the JWKS URL
# served"; whoever can influence that response can serve a key of their own (even under the real
# key's kid). The key that verified each token is identified by its RFC 7638 SHA-256 thumbprint
# (43 base64url chars, computed from the key, never from kid) and checked against this csv.
# ONE list covers both JWKS sets above. Read the current values — public, no login needed — with
#   node scripts/web3authJwksThumbprints.js
# and CHECK each key before pinning (README "Web3Auth signing-key pins" runbook). Pin the current
# AND the next key whenever Web3Auth publishes the next one. Malformed entries refuse boot.
WEB3AUTH_JWKS_PINNED_THUMBPRINTS=""
# off     = no check
# log     = accept, but warn `jwks_key_not_pinned` {kid, thumbprint, jwksUrl} (default; rollout)
# enforce = 401 IDTOKEN_KEY_NOT_PINNED, logged at error level with the same fields. Requires a
#           non-empty list (boot refuses otherwise). REQUIRED when SSO_TGE_ENABLED=true.
#           Integrity over availability, deliberately: when Web3Auth rotates to a key that is not
#           pinned, EVERY login fails until the operator verifies it, adds its pin and restarts.
WEB3AUTH_JWKS_PIN_MODE="log"
# Accepted JWS algorithms (csv) and maximum token age (jose duration, e.g. 1d, 12h)
WEB3AUTH_ALGS="ES256"
WEB3AUTH_MAX_TOKEN_AGE="1d"
# Claim paths (csv, first present wins; dot paths allowed). v9 names first, v10 names as fallback.
WEB3AUTH_VERIFIER_CLAIM="aggregateVerifier,verifier,groupedAuthConnectionId,authConnectionId"
WEB3AUTH_VERIFIER_ID_CLAIM="verifierId,userId"
WEB3AUTH_EMAIL_CLAIM="email"
# Claim (dot path) carrying the IdP's own "I verified this address" flag. Only a real boolean
# true counts; without it the e-mail is never used to find an existing account.
WEB3AUTH_EMAIL_VERIFIED_CLAIM="email_verified"
WEB3AUTH_WALLETS_CLAIM="wallets"
# How the claimed wallet is checked against the token: public_key (derive address from
# wallets[].public_key, also accepts wallets[].address), address (wallets[].address only), none (never bind from token)
WEB3AUTH_WALLET_MATCH="public_key"
# Verifier names allowed to lazily link a legacy `web3auth` row by the e-mail the token asserts (csv).
# EMPTY = NEVER link by e-mail (opt-in only, by name). Even when allow-listed, an IdP-asserted
# e-mail also needs WEB3AUTH_EMAIL_VERIFIED_CLAIM === true, an unlinked non-organization
# `web3auth` row, and no wallet mismatch. Linking by a wallet the token PROVES needs none of this.
WEB3AUTH_LEGACY_VERIFIERS=""
# `log` mode only: may a request that sends NO idToken still log in with the body-asserted
# identity (e-mail / wallet / xid)? false = no; that is the historical takeover path. Turn it on
# only for the rollout window, watch the `legacy_login` log count, then turn it off and go enforce.
WEB3AUTH_ALLOW_LEGACY_FALLBACK="false"

# --- Web3Auth network switch (Sapphire devnet -> Sapphire mainnet, phase 1) -------------------
# One maintenance window moves the Wallet (app/api.datadance.ai) and the TGE login (SSO) to the
# Sapphire MAINNET project. Web3Auth migrates nothing: every connection name and every derived
# wallet changes, so without the re-bind below every existing user's first mainnet login is
# refused (IDENTITY_CONFLICT). Runbook: scripts/mainnetSwitch.js header and the PR description.
#
# Values AT THE CUT (today's devnet values in brackets):
#   WEB3AUTH_CLIENT_ID              = the mainnet project's client id (BBpkxUTUr…)   [devnet BGiGcxrX…]
#                                     It is the only accepted audience: devnet tokens from old App
#                                     builds are refused from then on (401 IDTOKEN_AUDIENCE).
#   WEB3AUTH_ALLOWED_VERIFIERS      = the mainnet connection names + external-wallet, and NO
#                                     …-sapphire-devnet name (mainnetSwitch.js refuses the cut then).
#                                     Only web3auth-google-sapphire-mainnet is documented by Web3Auth;
#                                     READ THE OTHERS from a real mainnet token on the day
#                                     (aggregateVerifier / groupedAuthConnectionId claim). Expected:
#                                       web3auth-google-sapphire-mainnet,
#                                       web3auth-auth0-email-passwordless-sapphire-mainnet,
#                                       web3auth-auth0-apple-sapphire-mainnet,
#                                       web3auth-auth0-twitter-sapphire-mainnet,
#                                       external-wallet
#   WEB3AUTH_LEGACY_VERIFIERS       = empty (the re-bind replaces it for legacy rows)
#   WEB3AUTH_NETWORK_REBIND         = on
#   WEB3AUTH_REBIND_VERIFIERS       = the four mainnet social names above (never external-wallet)
#   WEB3AUTH_EMAIL_TRUSTED_VERIFIERS= Google + e-mail passwordless (+ Apple: Apple releases only
#                                     addresses it verified, relay ones included); NOT X
#   WEB3AUTH_VERIFY_MODE=enforce, WEB3AUTH_ALLOW_LEGACY_FALLBACK=false, WEB3AUTH_WALLET_MATCH=public_key,
#   WEB3AUTH_JWKS_PIN_MODE=enforce with WEB3AUTH_JWKS_PINNED_THUMBPRINTS re-read on the day
#   (node scripts/web3authJwksThumbprints.js) — all required by SSO_TGE_ENABLED=true anyway.
#   WEB3AUTH_EXTERNAL_AUDIENCE      = empty (= WEB3AUTH_CLIENT_ID) or the mainnet id. If it still
#                                     holds the devnet id, every external-wallet login fails;
#                                     mainnetSwitch.js reports NO-GO then.
#   WEB3AUTH_RETIRED_CLIENT_IDS     = the devnet client id (BGiGcxrX…, public), and
#   LOGIN_MISSING_IDTOKEN_MEANS_OLD_APP = on: the old store Apps are then told to update (426
#                                     APP_UPDATE_REQUIRED) instead of failing to log in (below).
#   Unchanged: WEB3AUTH_JWKS_URL / ISSUERS / EXTERNAL_JWKS_URL / EXTERNAL_ISSUERS and the claim paths.
#   Deploy main + this change TOGETHER with these values in one restart: running the new build
#   with the devnet values in between can link devnet pairs (--apply clears them, but why bother).
#   Only "on" and "off" are accepted for WEB3AUTH_NETWORK_REBIND: "false"/"0" stop the boot.
#
# off = today's behaviour, unchanged. on = an account recorded by
# `node scripts/mainnetSwitch.js --apply` re-binds on its first login through a connection named
# below: same User.id (points, referrals, invite code, partner `sub`), the new connection pair, and
# — for a Web3Auth-derived old-network address — the address the token PROVES (the old one stays
# in Web3AuthNetworkRebind). Server-held and external wallets are never changed or cleared.
# Boot refuses `on` unless: VERIFY_MODE log|enforce, ALLOW_LEGACY_FALLBACK=false, WALLET_MATCH not
# none, ALLOWED_VERIFIERS set, REBIND_VERIFIERS set, inside ALLOWED_VERIFIERS and without
# external-wallet, EMAIL_TRUSTED_VERIFIERS inside REBIND_VERIFIERS.
# Leave it on until `--plan` shows no pending records you still expect back (phase 2 at the latest):
# while on, the partner API also reports a pending account's old address as unbound
# (wallet_bound=false, wallet_address=null) until the re-bind binds the new one.
# An address a re-bind REPLACED is never a login credential again: a token proving it gets 409
# (replaced_wallet), no session and no new account. Pre-P0 the stored wallet came from the
# request body, so it may be a squatter's. List known external-wallet owners in --keep-wallet-ids
# before --apply so their wallet is kept instead of replaced.
WEB3AUTH_NETWORK_REBIND="off"
# New-network connections (csv) that may re-bind a recorded account: by the exact verifierId the
# token carries (X: twitter|<id> in the e-mail column), or by e-mail when also listed below.
WEB3AUTH_REBIND_VERIFIERS=""
# Subset of WEB3AUTH_REBIND_VERIFIERS that verifies the e-mail itself (Web3Auth's built-in Google
# and e-mail passwordless; Apple). Web3Auth tokens never carry email_verified, so this list is what
# stands in for it — and only for recorded legacy accounts. It applies to every account found by an
# e-mail-shaped key, whether the token carried the address as an `email` claim or as its verifierId;
# a connection left off this list re-binds only by an exact non-e-mail verifierId (X: twitter|<id>).
# Caveat: Google normally releases only verified addresses, but a Google account created with a
# third-party address can in edge cases be unverified upstream; listing Google accepts that. Also: an account re-bound through one of
# these may then be signed into through another one with the same e-mail (legacy accounts were
# e-mail keyed); anything else on a linked account stays 409 candidate_already_linked.
WEB3AUTH_EMAIL_TRUSTED_VERIFIERS=""

# --- Old App builds after the network switch: "please update" instead of a failed login -------
# The store Apps built for the devnet project (iOS 2.0.2, Android 1.0.2) send a devnet idToken, and
# iOS 2.0.1 sends none. After the cut those logins are refused (401 IDTOKEN_AUDIENCE, 400
# IDTOKEN_REQUIRED) and the Apps show "sign in again" or a technical message. These two settings
# change ONLY the answer to such an already-refused login, to HTTP 426:
#   {status:"fail", success:false, code:"APP_UPDATE_REQUIRED", message:"<Traditional Chinese + English:
#    this App version is no longer supported, please update>", update:{ios, android}}
# which those Apps display as is. The links are the ones GET /api/app/version-policy serves
# (APP_STORE_URL_IOS, default our App Store listing; APP_DOWNLOAD_URL_ANDROID, null unless set).
# No session, no account lookup, nothing written, logged as idtoken_rejected with codes only; a valid
# token, a legacy-fallback login (log mode) and every other refusal are unchanged.
# The boot prints one line with both: "Old App update answer (426 APP_UPDATE_REQUIRED):
# WEB3AUTH_RETIRED_CLIENT_IDS count=<n> first8=<first 8 characters of each> LOGIN_MISSING_IDTOKEN_MEANS_OLD_APP=<on|off>".
# Web3Auth client ids (csv) of retired App builds. A token refused with IDTOKEN_AUDIENCE whose `aud`
# (read unverified, only to choose this answer) is listed gets the 426. Empty = never. In production
# the boot refuses an entry that is also WEB3AUTH_CLIENT_ID or a WEB3AUTH_EXTERNAL_AUDIENCE entry.
WEB3AUTH_RETIRED_CLIENT_IDS=""
# on | off. on = a login with NO idToken that is refused with IDTOKEN_REQUIRED gets the 426. Only App
# builds from before the idToken log in without one. Any other value stops the boot.
LOGIN_MISSING_IDTOKEN_MEANS_OLD_APP="off"

# Partner (TGE) SSO — static confidential OAuth client, configured here only (never in the DB).
# Generate SSO_TGE_CLIENT_SECRET_SHA256 with: node scripts/genPartnerSecret.js
# See docs/TGE_SSO.md. Test and prod deployments carry DIFFERENT client ids, hashes and redirect URIs.
SSO_ENVIRONMENT="test"                       # test | prod (required when SSO_TGE_ENABLED=true)
SSO_TGE_ENABLED="false"                      # kill switch; false → /oauth/token and /partner/tge/* refuse the client
SSO_TGE_CLIENT_ID="tge-test"                 # [A-Za-z0-9._-]{1,64}
SSO_TGE_CLIENT_NAME="DDC TGE"
SSO_TGE_CLIENT_SECRET_SHA256=""              # 64-hex sha256 of the secret handed to the partner
SSO_TGE_CLIENT_SECRET_SHA256_PREVIOUS=""     # rotation: old hash, accepted until ROTATION_UNTIL
SSO_TGE_SECRET_ROTATION_UNTIL=""             # ISO-8601, e.g. 2026-10-01T00:00:00Z
SSO_TGE_REDIRECT_URIS="https://tge.example.com/oauth/callback"   # csv, exact match; https only (http for localhost outside prod)
SSO_TGE_INITIATE_LOGIN_URI=""                # Phase 3 App hand-off target; required for /api/sso/* (no URI → CLIENT_DISABLED)
SSO_TGE_STATUS_FIELDS="registered_at,wallet_bound,data_licence_granted,avatar"   # frozen /partner/tge fields; unset → nothing is served. avatar is omitted when the account has no picture
SSO_TGE_AUTO_APPROVE="off"                   # off | app | app,web — consent entries whose Allow the Wallet may post without a tap (TGE client only; unknown → off). The server still runs the full manual-Allow checks.
SSO_TGE_APP_PRESENTATION="webview"          # webview | browser — how the App opens the partner hand-off; "browser" = remote kill switch back to the system browser sheet
SSO_DEVELOPER_REGISTRATION="off"            # off | on — self-serve SSO client registration. off (default): 403 registration_closed for every caller, nothing written; clients registered earlier keep working. on: still requires a signed-in DataDance account (anonymous → 401), so a self-serve console must send the user's token. Read once at boot; any other value refuses to start in production. See docs/TGE_SSO.md §14
# The per-field freeze list above is the second gate on every optional field; the first is the
# scope the user granted. Both must be open. Candidates, and what each one costs the user:
#   registered_at, wallet_bound, data_licence_granted   scope tge:status    — on by default above
#   email_masked                                        scope tge:identity  — j***@domain.com display hint
#   email                                               scope tge:email     — the REAL address
#   wallet_address                                      scope tge:wallet    — the bound address, EIP-55
#   points                                              scope tge:points    — live balance, never cacheable
#   referral                                            scope tge:referral  — own code, inviter id, direct-invitee COUNT
#   referral_network                                    scope tge:referral_network — GET /partner/tge/referral-network:
#                                                       every upline and downline id at any depth (404 not_available if unlisted)
# email, wallet_address, points, referral and referral_network are OFF until listed here: a deploy alone exposes
# nothing new. A field that is not listed is absent from the body, not null.
SSO_REQUIRE_VERIFIED_SESSION="false"         # true → partner consent needs a DDC JWT with ver>=2 (P0 verified login)
SSO_TGE_REFERRAL_BIND="false"                # true → POST /partner/tge/referral/bind/check then /referral/bind {code, confirm_token} (scope tge:referral_bind, auto-approvable), the partner API's only write; off → 404 not_available and /oauth/authorize refuses the scope. Confirm tokens are HMAC-signed with a key derived from SSO_SESSION_SECRET (120 s). Turn on only after the Wallet ships consent copy for it

# Phase 3 App->browser hand-off (/api/sso/app-ticket, /api/sso/ticket/exchange).
# SSO_SESSION_SECRET signs the consent-only SSO session. It MUST differ from JWT_SECRET:
# that difference is what keeps the session out of every other authenticated endpoint
# (`protect` verifies against JWT_SECRET and rejects it). Boot fails when SSO_TGE_ENABLED=true
# and the secret is missing or equal to JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SSO_SESSION_SECRET=""                        # dedicated HS256 key for the consent-only App SSO session
SSO_TICKET_TTL_SEC="60"                      # hand-off ticket lifetime (contract: 60)
SSO_APP_SESSION_TTL_SEC="43200"              # App SSO session lifetime = the in-App page (decision 37); clamped 300..43200, reusable for several consents

# Money-path boot assertions. SSO_TGE_ENABLED=true is the switch that puts DataDance identities
# in front of the partner page, so from that moment the container REFUSES TO START unless:
#   NODE_ENV=production, WEB3AUTH_VERIFY_MODE=enforce, WEB3AUTH_ALLOW_LEGACY_FALLBACK=false,
#   WEB3AUTH_CLIENT_ID and WEB3AUTH_ALLOWED_VERIFIERS non-empty, WEB3AUTH_JWKS_PIN_MODE=enforce
#   with a non-empty, well-formed WEB3AUTH_JWKS_PINNED_THUMBPRINTS, SSO_SESSION_SECRET set and
#   different from JWT_SECRET, PUBLIC_BASE_URL and APP_PUBLIC_URL set and https.
# There is no variable to switch that off: turn SSO_TGE_ENABLED off instead. The boot log prints
# a summary of the values (never the secrets; the pins only as a count). See README "Partner SSO
# boot assertions".
#
# Authorization-request ↔ browser binding has no switch either: GET /oauth/authorize always sets
# the `__Host-ddc_authz` cookie and POST /api/oauth/consent always requires it back, so a consent
# link that is forwarded to another browser can never mint a code. The Wallet consent page MUST
# send the request with credentials (`fetch(..., { credentials: 'include' })`) or every approval
# answers 409 AUTHZ_INITIATOR_MISMATCH.
