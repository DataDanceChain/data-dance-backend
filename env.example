# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/test_datadance?schema=public"

# JWT 密钥
JWT_SECRET="your-secret-key"
JWT_EXPIRES_IN="7d"

# 服务器配置
PORT=8080
NODE_ENV="development"

# API Base URL (使用 ngrok 提供的 URL)
API_BASE_URL="https://35ed-154-29-144-72.ngrok-free.app"

# Connect AI / MCP OAuth (issuer = API origin; consent page = Wallet origin)
PUBLIC_BASE_URL="https://api.datadance.ai"
APP_PUBLIC_URL="https://app.datadance.ai"
FRONTEND_URL="https://app.datadance.ai"

# Default invoice seller when an order has no merchant
INVOICE_SELLER_USER_ID=""
INVOICE_SELLER_EMAIL=""
INVOICE_SELLER_TAX_ID=""
INVOICE_SELLER_ADDRESS=""

# Apple Push Notification Service
APNS_KEY_ID="QW9B77ZUW9"
APNS_TEAM_ID="R2DAZ94F4S" 
# Partner (TGE) SSO — static confidential OAuth client, configured here only (never in the DB).
# Generate SSO_TGE_CLIENT_SECRET_SHA256 with: node scripts/genPartnerSecret.js
# See docs/TGE_SSO.md. Test and prod deployments carry DIFFERENT client ids, hashes and redirect URIs.
SSO_ENVIRONMENT="test"                       # test | prod (required when SSO_TGE_ENABLED=true)
SSO_TGE_ENABLED="false"                      # kill switch; false → /oauth/token and /partner/tge/* refuse the client
SSO_TGE_CLIENT_ID="tge-test"                 # [A-Za-z0-9._-]{1,64}
SSO_TGE_CLIENT_NAME="DDC TGE"
SSO_TGE_CLIENT_SECRET_SHA256=""              # 64-hex sha256 of the secret handed to the partner
SSO_TGE_CLIENT_SECRET_SHA256_PREVIOUS=""     # rotation: old hash, accepted until ROTATION_UNTIL
SSO_TGE_SECRET_ROTATION_UNTIL=""             # ISO-8601, e.g. 2026-10-01T00:00:00Z
SSO_TGE_REDIRECT_URIS="https://tge.example.com/oauth/callback"   # csv, exact match; https only (http for localhost outside prod)
SSO_TGE_INITIATE_LOGIN_URI=""                # Phase 3 App hand-off target (optional for now)
SSO_TGE_STATUS_FIELDS="registered_at,wallet_bound,data_licence_granted"   # frozen /partner/tge fields; unset → all null; add email_masked to expose it on /me
SSO_REQUIRE_VERIFIED_SESSION="false"         # true → partner consent needs a DDC JWT with ver>=2 (P0 verified login)
