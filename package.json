    "dotenv": "^16.0.3",
    "ethers": "^6.14.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "nanoid": "^5.1.5",
    "rate-limiter-flexible": "^4.0.1",
    "twitter-api-v2": "^1.23.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
