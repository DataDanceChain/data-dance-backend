# Test API. Own database, own SSO client id, Devnet Web3Auth.
# Do not copy secrets from /root/ddc-backend/backend.env.
NODE_ENV=production
PUBLIC_BASE_URL=https://staging-api.datadance.ai
APP_PUBLIC_URL=https://staging.datadance.ai

WEB3AUTH_VERIFY_MODE=enforce
WEB3AUTH_ALLOW_LEGACY_FALLBACK=false
WEB3AUTH_CLIENT_ID=
WEB3AUTH_ALLOWED_VERIFIERS=
WEB3AUTH_JWKS_PIN_MODE=log

# Identity only. Payouts stay on BSC testnet.
DISBURSEMENT_NETWORK=testnet

# Leave off until the staging wallet, client id, and redirect URLs exist.
SSO_TGE_ENABLED=false
SSO_TGE_CLIENT_ID=tge-test
