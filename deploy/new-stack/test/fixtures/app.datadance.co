# SYNTHETIC test fixture for test/run-local-tests.sh, written for the tests: not a copy of any server's file.
# It has only the shape that 30-nginx.sh render and nginx -t need from an app vhost, including the http-level
# upgrade map that both fixtures use.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    server_name app.datadance.ai;

    location ^~ /downloads/ {
        alias /opt/ddc/downloads/;
        default_type application/octet-stream;
        add_header Content-Disposition "attachment";
    }

    location = /architecture {
        return 301 /architecture/;
    }

    location ^~ /architecture/ {
        alias /opt/ddc/docs/architecture/;
        index index.html;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_pass http://localhost:9001;
    }

    listen 80;
}
