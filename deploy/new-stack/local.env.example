# local.env.example - copy this file to local.env (same directory) and replace both CHANGE_ME values.
# local.env is gitignored and must never be committed: this repository is public. It is the only place on the
# operator's Mac where the server login and the 1Password reference are written down.
#
# DDC_SSH_TARGET     user@host of the SSH login to the production server. The host is in the private Drive
#                    runbook. The scripts run on the server as root and refuse to run otherwise.
# DDC_OP_SECRET_REF  the 1Password secret reference of that login's password (in 1Password: the field's
#                    "Copy Secret Reference"; it has the form op://<vault>/<item>/<field>). Never the password itself.
#
# remote.sh and survey/ro-ssh.sh read nothing else from this file. They refuse to connect, and do not ask
# 1Password, while this file is missing, a value is empty, a value is still CHANGE_ME, or a value has the wrong shape.
DDC_SSH_TARGET=CHANGE_ME
DDC_OP_SECRET_REF=CHANGE_ME
