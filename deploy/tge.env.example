# TGE production API. Own database, own SSO client id, Sapphire Mainnet Web3Auth.
# This is not the live wallet API. Do not load this file into ddc-backend-api.
NODE_ENV=production
PUBLIC_BASE_URL=https://api-rehearsal.datadance.ai
APP_PUBLIC_URL=https://app-rehearsal.datadance.ai

WEB3AUTH_VERIFY_MODE=enforce
WEB3AUTH_ALLOW_LEGACY_FALLBACK=false
# Sapphire Mainnet project client id. Not the Devnet client id.
WEB3AUTH_CLIENT_ID=BBpkxUTUr-T2vWd47895CsTnX7fgd6dD11UuRa4fvMJBBtH7gVQrSQEOAdlvTGGgrsvlk25Qaonpza8f8lUrJY4
WEB3AUTH_ALLOWED_VERIFIERS=
# Dashboard JWKS. Same two keys as https://api-auth.web3auth.io/jwks. The verifier does not follow redirects.
WEB3AUTH_JWKS_URL=https://api-auth.web3auth.io/.well-known/jwks.json
WEB3AUTH_ISSUERS=https://api-auth.web3auth.io
WEB3AUTH_JWKS_PIN_MODE=enforce
WEB3AUTH_JWKS_PINNED_THUMBPRINTS=TYOgg_-5EOEblaY-VVRYqVaDAgptnfKV4535MZPC0w0,G6-iP7C_4NdppFwiEuckNCU_etFIVBBxxt4UH9cB9G0

# Chain stays BSC testnet until the receiving wallet is decided.
DISBURSEMENT_NETWORK=testnet

# Turn on only after the Mainnet client id, JWKS pins, and a dedicated
# SSO_SESSION_SECRET (different from JWT_SECRET) are set. Boot refuses to
# start if any of those are missing.
SSO_TGE_ENABLED=false
SSO_TGE_CLIENT_ID=tge-prod
