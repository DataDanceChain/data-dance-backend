generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  password                 String?
  name                     String?
  avatar                   String?
  walletAddress            String?                   @unique
  chainId                  Int?
  privateKey               String?
  authType                 String                    @default("traditional")
  userType                 String                    @default("regular")
  isOrganization           Boolean                   @default(false)
  description              String?
  logo                     String?
  xid                      String?                   @unique
  xUsername                String?
  xAccessToken             String?
  xRefreshToken            String?
  referralCode             String                    @unique
  legacyReferralCode       String?                   @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  totalPoints              Float                     @default(0)
  organizationId           String?
  createdActivities        Activity[]
  activityClaims           ActivityClaim[]
  transactions             AssetTransaction[]
  createdBadges            Badge[]
  crawlerData              CrawlerData[]
  crawlerTasks             CrawlerTask[]
  dataDanceIDs             DataDanceID[]
  dataNFTs                 DataNFT[]
  dataNFTPurchases         DataNFTPurchase[]
  dataAssets               NFTDataAsset[]
  nftMarketOrders          NftMarketOrder[]
  notifications            Notification[]
  organizationTransactions OrganizationTransaction[]
  passes                   Pass[]
  points                   Point[]
  invitesReceived          Referral?                 @relation("InvitesReceived")
  invitesSent              Referral[]                @relation("InvitesSent")
  snapshots                Snapshot[]
  organization             User?                     @relation("OrganizationMembers", fields: [organizationId], references: [id])
  members                  User[]                    @relation("OrganizationMembers")
  UserAwards               UserAward[]
  badges                   UserBadge[]
  profile                  UserProfile?
  roles                    UserRole[]
  UserTasks                UserTask[]
  dailyEvents              UserDailyEvent[]
  legalEntity              LegalEntity?
  purchaseOrdersAsBuyer    PurchaseOrder[]           @relation("OrderBuyer")
  purchaseOrdersAsSeller   PurchaseOrder[]           @relation("OrderSeller")
  invoicesAsBuyer          Invoice[]                 @relation("InvoiceBuyer")
  invoicesAsSeller         Invoice[]                 @relation("InvoiceSeller")
  paymentsAsPayer          Payment[]                 @relation("PaymentPayer")
  paymentsAsPayee          Payment[]                 @relation("PaymentPayee")
  procurementAllocations   ProcurementAllocation[]
  pointsRedemptions        PointsRedemption[]
  lifeContextSettings      LifeContextSettings?
  dataLicenceConsent       DataLicenceConsent?
  privacyRequests          PrivacyRequest[]
  mcpTokens                McpToken[]
  oauthAuthorizations      OAuthAuthorization[]
  oauthRefreshTokens       OAuthRefreshToken[]
  campaignApplications     CampaignApplication[]
  campaignRaffleTickets    CampaignRaffleTicket[]
  campaignRaffleWins       CampaignRaffleWin[]
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  phone             String?
  language          String   @default("en")
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userRoles   UserRole[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Point {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  source    String
  sourceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

// Generic daily event log for reward tasks (e.g. check-in, rewards hub visit)
model UserDailyEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String
  day       DateTime // normalized to start-of-day UTC
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, day])
  @@index([userId, day])
  @@index([type, day])
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String
  creatorId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
  creator     User        @relation(fields: [creatorId], references: [id])
  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  acquiredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  badge      Badge    @relation(fields: [badgeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model NFTDataAsset {
  id             String          @id @default(uuid())
  name           String
  description    String?
  metadata       Json
  ownerId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authorizations Authorization[]
  listings       Listing[]
  owner          User            @relation(fields: [ownerId], references: [id])
}

model Authorization {
  id          String       @id @default(uuid())
  assetId     String
  grantedTo   String
  permissions Json
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  asset       NFTDataAsset @relation(fields: [assetId], references: [id])
}

model AssetTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  amount      Float?
  assetId     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Activity {
  id                 String             @id @default(uuid())
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime?
  image              String?
  creatorId          String
  budget             Float?
  bidStrategy        Json?
  shareLink          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  equityDetails      String[]
  equityTitle        String?
  externalLinks      Json?
  externalLinksTitle String?
  nftDescription     String?
  nftImage           String?
  nftName            String?
  nftPrice           Float?
  nftTotalSupply     Int?
  nftUsageRules      String?
  nftValidityEnd     DateTime?
  nftValidityStart   DateTime?
  remaining          Int?
  showInExplore      Boolean            @default(true)
  statusNote         String?
  total              Int?
  type               String             @default("MEMBERSHIP")
  contractAddress    String?
  chainId            Int?
  tokenStandard      String?
  isPromoted         Boolean            @default(false)
  promotionInfo      Json?
  creator            User               @relation(fields: [creatorId], references: [id])
  claims             ActivityClaim[]
  dataDanceIDs       DataDanceID[]
  nftMarketOrders    NftMarketOrder[]
  snapshots          Snapshot[]
  categories         ActivityCategory[] @relation("ActivityToActivityCategory")
  tags               Tag[]              @relation("ActivityToTag")
}

model ActivityCategory {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToActivityCategory")
}

model Tag {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToTag")
  dataNFTs   DataNFT[]  @relation("DataNFTToTag")
  snapshots  Snapshot[] @relation("SnapshotToTag")
}

model ActivityClaim {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  status     String
  claimedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

model Listing {
  id        String       @id @default(uuid())
  assetId   String
  price     Float
  currency  String       @default("USD")
  status    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  asset     NFTDataAsset @relation(fields: [assetId], references: [id])
  orders    Order[]
}

model Order {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  status    String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model DataDanceID {
  id         String   @id @default(uuid())
  identifier String   @unique
  userId     String
  activityId String
  status     String   @default("ACTIVE")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

model CrawlerTask {
  id          String        @id @default(uuid())
  taskId      String?       // 对应 TASK_TEMPLATES 中的 taskId (e.g., "booking_past_trips")
  title       String
  description String?
  source      String
  status      String        @default("pending")
  recordCount Int           @default(0)
  dataUrl     String?
  log         String?
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  data        CrawlerData[]
  user        User          @relation(fields: [userId], references: [id])
}

model CrawlerData {
  id          String      @id @default(uuid())
  source      String
  type        String
  timestamp   DateTime
  metadata    Json
  payload     Json
  taskId      String
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contentHash String      @unique
  sourceId    String?
  task        CrawlerTask @relation(fields: [taskId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([userId, source, sourceId])
  @@index([userId, createdAt])
}

model Award {
  id          String      @id @default(uuid())
  title       String
  description String
  icon        String?
  color       String?
  status      AwardStatus @default(LOCKED)
  metadata    Json?       @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tasks       Task[]
  UserAwards  UserAward[]
}

model UserAward {
  id        String      @id @default(uuid())
  userId    String
  awardId   String
  status    AwardStatus @default(LOCKED)
  claimed   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Award     Award       @relation(fields: [awardId], references: [id])
  User      User        @relation(fields: [userId], references: [id])

  @@unique([userId, awardId])
}

model Task {
  id                 String      @id @default(uuid())
  awardId            String
  title              String
  description        String?
  status             AwardStatus @default(LOCKED)
  prerequisiteTaskId String?
  claimLimit         Int?
  requirementCount   Int?
  points             Int
  icon               String?
  picture            String?
  url                String?
  metadata           Json?       @default("{}")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  award              Award       @relation(fields: [awardId], references: [id])
  prerequisiteTask   Task?       @relation("TaskPrerequisite", fields: [prerequisiteTaskId], references: [id])
  dependentTasks     Task[]      @relation("TaskPrerequisite")
  UserTasks          UserTask[]
}

model UserTask {
  id           String      @id @default(uuid())
  userId       String
  taskId       String
  status       AwardStatus @default(LOCKED)
  claimRecords DateTime[]  @default(dbgenerated("(ARRAY[]::timestamp without time zone[])::timestamp(3) without time zone[]"))
  claimed      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  task         Task        @relation(fields: [taskId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@unique([userId, taskId])
}

model Referral {
  id           String   @id @default(uuid())
  inviterId    String
  inviteeId    String   @unique
  code         String
  campaignSlug String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  invitee      User     @relation("InvitesReceived", fields: [inviteeId], references: [id])
  inviter      User     @relation("InvitesSent", fields: [inviterId], references: [id])

  @@index([inviterId, campaignSlug])
}

model XPostCache {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pass {
  id                 String   @id @default(uuid())
  creatorId          String
  creatorName        String
  creatorLogo        String
  userId             String
  userName           String
  userWalletAddress  String
  passUrl            String?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  pushToken          String?
  serialNumber       String?  @unique
  updatedAt          DateTime @updatedAt
  passTypeIdentifier String   @default("pass.ai.datadance.app")
  platform           String   @default("apple")
  googleObjectId     String?
  googleClassId      String?
  googleAddUrl       String?
  user               User     @relation(fields: [userId], references: [id])

  @@unique([userId, creatorId, platform])
  @@index([creatorId])
  @@index([userId])
}

model NftMarketOrder {
  id          String   @id @default(uuid())
  userId      String
  activityId  String
  quantity    Int
  price       Float
  total       Float
  purchasedAt DateTime @default(now())
  activity    Activity @relation(fields: [activityId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([activityId])
}

model Snapshot {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String
  description String?
  activityId  String
  merchantId  String
  claims      Json?
  activity    Activity  @relation(fields: [activityId], references: [id])
  merchant    User      @relation(fields: [merchantId], references: [id])
  dataNFTs    DataNFT[] @relation("DataNFTToSnapshot")
  tags        Tag[]     @relation("SnapshotToTag")
}

model DataNFT {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  name         String
  description  String?
  price        Float
  isPublished  Boolean           @default(false)
  maxSales     Int               @default(1)
  currentSales Int               @default(0)
  merchantId   String
  image        String?
  
  // 数据来源标识和数据存储
  dataSource   String            @default("activity") // "activity" | "upload"
  dataRecords  Json?             // 用于存储直接上传的CSV数据
  
  // 区块链相关字段
  blockchainTokenId    String?   @unique // 链上的 token ID (serial 序号)
  blockchainTxHash     String?   // 上链交易的 hash
  blockchainRecordedAt DateTime? // 上链时间
  
  merchant     User              @relation(fields: [merchantId], references: [id])
  purchases    DataNFTPurchase[]
  snapshots    Snapshot[]        @relation("DataNFTToSnapshot")
  tags         Tag[]             @relation("DataNFTToTag")
}

model DataNFTPurchase {
  id                 String    @id @default(uuid())
  createdAt          DateTime  @default(now())
  dataNFTId          String
  buyerId            String
  quantity           Int       @default(1)
  licenceAcceptedAt  DateTime?
  licenceVersion     String?
  buyer              User      @relation(fields: [buyerId], references: [id])
  dataNFT            DataNFT   @relation(fields: [dataNFTId], references: [id])

  @@index([dataNFTId, buyerId])
}

model OrganizationTransaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String
  status      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

enum AwardStatus {
  LOCKED
  LIVE
  INVALID
}

model LegalEntity {
  id               String    @id @default(uuid())
  userId           String    @unique
  companyName      String
  taxId            String?
  brNumber         String?
  beneficialOwner  String?
  address          String?
  country          String?
  email            String?
  bankName         String?
  bankAccount      String?
  currency         String    @default("USD")
  kycStatus        String    @default("incomplete")
  kycSubmittedAt   DateTime?
  kycReviewedAt    DateTime?
  kycReviewedBy    String?
  kycNote          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
}

model PurchaseOrder {
  id             String          @id @default(uuid())
  orderNumber    String          @unique
  buyerId        String
  sellerId       String
  status         String          @default("confirmed")
  currency       String          @default("USD")
  subtotal       Float
  taxAmount      Float           @default(0)
  total          Float
  paymentTerms   String          @default("Due on receipt")
  notes          String?
  contractFile         String?
  contractStatus       String          @default("none")
  licenceAcceptedAt    DateTime?
  licenceVersion       String?
  dataNFTId            String?
  purchaseId           String?
  attestationHash      String?
  attestationTxHash    String?
  attestedAt           DateTime?
  attestationPayload   Json?
  pointsUnitPriceUsd   Float?
  serviceFeeAmount     Float           @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  buyer                User            @relation("OrderBuyer", fields: [buyerId], references: [id])
  seller               User            @relation("OrderSeller", fields: [sellerId], references: [id])
  lineItems            OrderLineItem[]
  invoices             Invoice[]
  payments             Payment[]
  allocations          ProcurementAllocation[]
  costItems            ProcurementCostItem[]
  redemptions          PointsRedemption[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([createdAt])
}

model OrderLineItem {
  id          String        @id @default(uuid())
  orderId     String
  description String
  category    String?
  quantity    Float
  unit        String        @default("license")
  unitPrice   Float
  total       Float
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String            @id @default(uuid())
  invoiceNumber  String            @unique
  orderId        String
  buyerId        String
  sellerId       String
  status         String            @default("issued")
  currency       String            @default("USD")
  subtotal       Float
  taxAmount      Float             @default(0)
  total          Float
  paymentTerms   String?
  issueDate      DateTime          @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  pdfPath        String?
  sellerSnapshot Json
  buyerSnapshot  Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  order          PurchaseOrder     @relation(fields: [orderId], references: [id])
  buyer          User              @relation("InvoiceBuyer", fields: [buyerId], references: [id])
  seller         User              @relation("InvoiceSeller", fields: [sellerId], references: [id])
  lineItems      InvoiceLineItem[]
  payments       Payment[]

  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  category    String?
  quantity    Float
  unit        String  @default("license")
  unitPrice   Float
  total       Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id                        String         @id @default(uuid())
  paymentNumber             String         @unique
  orderId                   String?
  invoiceId                 String?
  payerId                   String
  payeeId                   String
  amount                    Float
  currency                  String         @default("USD")
  method                    String         @default("bank_transfer")
  status                    String         @default("pending")
  matchStatus               String         @default("unmatched")
  paidAt                    DateTime?
  reference                 String?
  slipPath                  String?
  notes                     String?
  organizationTransactionId String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  order                     PurchaseOrder? @relation(fields: [orderId], references: [id])
  invoice                   Invoice?       @relation(fields: [invoiceId], references: [id])
  payer                     User           @relation("PaymentPayer", fields: [payerId], references: [id])
  payee                     User           @relation("PaymentPayee", fields: [payeeId], references: [id])

  @@index([orderId])
  @@index([invoiceId])
  @@index([payerId])
  @@index([payeeId])
}

model CommerceSettings {
  id                 String   @id @default("default")
  pointsUnitPriceUsd Float    @default(0.01)
  updatedAt          DateTime @updatedAt
}

model ProcurementAllocation {
  id              String        @id @default(uuid())
  orderId         String
  kind            String
  email           String
  emailNormalized String
  displayName     String?
  role            String?
  points          Float         @default(0)
  userId          String?
  claimStatus     String        @default("reserved")
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([kind])
  @@index([emailNormalized])
}

model ProcurementCostItem {
  id          String        @id @default(uuid())
  orderId     String
  kind        String
  description String
  points      Float
  unitPriceUsd Float
  amountUsd   Float
  sourceType  String?
  sourceId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([kind])
}

model PointsRedemption {
  id              String         @id @default(uuid())
  orderId         String?
  createdById     String?
  email           String
  emailNormalized String
  userId          String?
  points          Float
  asset           String         @default("USDT")
  amount          Float
  vendor          String?
  vendorReference String?
  proofPath       String?
  status          String         @default("pending")
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  order           PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([emailNormalized])
  @@index([status])
}

/// Distilled lifestyle share settings for Connect AI (ChatGPT / Claude MCP).
model LifeContextSettings {
  userId           String    @id
  privacyLevel     String    @default("transparent")
  customBoundaries String    @default("")
  aboutMe          String    @default("")
  refinedJson      Json?
  refinedAt        DateTime?
  refinedModel     String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// C-end request to access, correct, or erase personal data (PDPO DPP6).
model PrivacyRequest {
  id         String    @id @default(uuid())
  userId     String
  kind       String
  detail     String?
  status     String    @default("open")
  opsNote    String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Express consent to license Connect records to business customers (HK PDPO).
model DataLicenceConsent {
  userId        String    @id
  policyVersion String
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  source        String    @default("connect")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Personal access tokens Claude / ChatGPT send as Bearer on /mcp.
model McpToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  tokenPrefix String
  label       String
  source      String    @default("manual")
  clientId    String    @default("")
  resource    String    @default("")
  scope       String    @default("")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens OAuthRefreshToken[]

  @@index([userId])
}

/// Public OAuth clients from DCR or CIMD (ChatGPT / Claude).
model OAuthClient {
  id                       String   @id @default(uuid())
  clientId                 String   @unique
  clientName               String
  redirectUris             String[]
  tokenEndpointAuthMethod  String   @default("none")
  clientUri                String   @default("")
  createdAt                DateTime @default(now())
}

/// In-flight authorization-code + PKCE request.
model OAuthAuthorization {
  id                  String    @id @default(uuid())
  clientId            String
  redirectUri         String
  state               String    @default("")
  codeChallenge       String
  codeChallengeMethod String
  resource            String
  scope               String
  codeHash            String?   @unique
  userId              String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model OAuthRefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  clientId   String
  mcpTokenId String
  resource   String
  scope      String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpToken   McpToken  @relation(fields: [mcpTokenId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ops-configured Wallet home card / announcement. Slot-filled templates only.
model Campaign {
  id            String          @id @default(uuid())
  slug          String          @unique
  internalName  String
  titleEn       String
  titleZh       String
  blurbEn       String
  blurbZh       String
  pillEn        String?
  pillZh        String?
  template      String
  status        String
  startsAt      DateTime
  endsAt        DateTime
  timezone      String          @default("UTC")
  ctaKind       String
  ctaValue      String
  purpose       String          @default("")
  legalText     String          @default("")
  legalVersion  Int             @default(1)
  coverImageUrl String?
  config        Json            @default("{}")
  createdBy     String
  updatedBy     String
  publishedBy   String?
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  events        CampaignEvent[]
  applications  CampaignApplication[]
  raffleTickets CampaignRaffleTicket[]
  raffleWins    CampaignRaffleWin[]

  @@index([status, startsAt, endsAt])
}

model CampaignApplication {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  answers    Json
  status     String   @default("pending")
  opsNote    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId, status])
}

model CampaignRaffleTicket {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  tickets    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model CampaignRaffleWin {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  prizeIndex Int
  prizeKind  String
  points     Int      @default(0)
  labelEn    String
  labelZh    String
  fulfilled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String
  actor      String
  action     String
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}
