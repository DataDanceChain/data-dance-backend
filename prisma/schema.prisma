generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String?
  name              String?
  avatar            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organizationId    String?
  description       String?
  isOrganization    Boolean            @default(false)
  logo              String?
  chainId           Int?
  totalPoints       Float              @default(0)
  walletAddress     String?            @unique
  privateKey        String?
  authType          String             @default("traditional")
  userType          String             @default("regular")
  createdActivities Activity[]
  activityClaims    ActivityClaim[]
  transactions      AssetTransaction[]
  createdBadges     Badge[]
  dataDanceIDs      DataDanceID[]
  dataAssets        NFTDataAsset[]
  notifications     Notification[]
  points            Point[]
  organization      User?              @relation("OrganizationMembers", fields: [organizationId], references: [id])
  members           User[]             @relation("OrganizationMembers")
  badges            UserBadge[]
  profile           UserProfile?
  roles             UserRole[]
  passes            Pass[]
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  phone             String?
  language          String   @default("en")
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userRoles   UserRole[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Point {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  source    String
  sourceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  creatorId   String
  creator     User        @relation(fields: [creatorId], references: [id])
  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  acquiredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  badge      Badge    @relation(fields: [badgeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model NFTDataAsset {
  id             String          @id @default(uuid())
  name           String
  description    String?
  metadata       Json
  ownerId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authorizations Authorization[]
  listings       Listing[]
  owner          User            @relation(fields: [ownerId], references: [id])
}

model Authorization {
  id          String       @id @default(uuid())
  assetId     String
  grantedTo   String
  permissions Json
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  asset       NFTDataAsset @relation(fields: [assetId], references: [id])
}

model AssetTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  amount      Float?
  assetId     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Activity {
  id                 String             @id @default(uuid())
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime?
  image              String?
  creatorId          String
  budget             Float?
  bidStrategy        Json?
  shareLink          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  equityDetails      String[]
  equityTitle        String?
  externalLinks      Json?
  externalLinksTitle String?
  nftDescription     String?
  nftImage           String?
  nftName            String?
  nftPrice           Float?
  nftTotalSupply     Int?
  nftUsageRules      String?
  nftValidityEnd     DateTime?
  nftValidityStart   DateTime?
  remaining          Int?
  showInExplore      Boolean            @default(true)
  statusNote         String?
  total              Int?
  type               String             @default("MEMBERSHIP")
  contractAddress    String?
  chainId            Int?
  tokenStandard      String?
  creator            User               @relation(fields: [creatorId], references: [id])
  claims             ActivityClaim[]
  dataDanceIDs       DataDanceID[]
  categories         ActivityCategory[] @relation("ActivityToActivityCategory")
  tags               ActivityTag[]      @relation("ActivityToActivityTag")
}

model ActivityCategory {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToActivityCategory")
}

model ActivityTag {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToActivityTag")
}

model ActivityClaim {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  status     String
  claimedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

model Listing {
  id        String       @id @default(uuid())
  assetId   String
  price     Float
  currency  String       @default("USD")
  status    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  asset     NFTDataAsset @relation(fields: [assetId], references: [id])
  orders    Order[]
}

model Order {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  status    String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model DataDanceID {
  id         String   @id @default(uuid())
  identifier String   @unique
  userId     String
  activityId String
  status     String   @default("ACTIVE")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

model Pass {
  id                String   @id @default(uuid())
  creatorId         String
  creatorName       String
  creatorLogo       String
  userId            String
  userName          String
  userWalletAddress String
  passUrl           String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  serialNumber      String?  @unique
  pushToken         String?
  updatedAt         DateTime @updatedAt
  passTypeIdentifier String  @default("pass.ai.datadance.app")

  // Relations
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, creatorId])
  @@index([creatorId])
  @@index([userId])
}
