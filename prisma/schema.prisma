generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  password                 String?
  name                     String?
  avatar                   String?
  walletAddress            String?                   @unique
  chainId                  Int?
  privateKey               String?
  authType                 String                    @default("traditional")
  userType                 String                    @default("regular")
  isOrganization           Boolean                   @default(false)
  description              String?
  logo                     String?
  xid                      String?                   @unique
  xUsername                String?
  xAccessToken             String?
  xRefreshToken            String?
  referralCode             String                    @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  totalPoints              Float                     @default(0)
  organizationId           String?
  createdActivities        Activity[]
  activityClaims           ActivityClaim[]
  transactions             AssetTransaction[]
  createdBadges            Badge[]
  crawlerData              CrawlerData[]
  crawlerTasks             CrawlerTask[]
  dataDanceIDs             DataDanceID[]
  dataNFTs                 DataNFT[]
  dataNFTPurchases         DataNFTPurchase[]
  dataAssets               NFTDataAsset[]
  nftMarketOrders          NftMarketOrder[]
  notifications            Notification[]
  organizationTransactions OrganizationTransaction[]
  passes                   Pass[]
  points                   Point[]
  snapshots                Snapshot[]
  invitesReceived          Referral?                 @relation("InvitesReceived")
  invitesSent              Referral[]                @relation("InvitesSent")
  organization             User?                     @relation("OrganizationMembers", fields: [organizationId], references: [id])
  members                  User[]                    @relation("OrganizationMembers")
  UserAwards               UserAward[]
  badges                   UserBadge[]
  profile                  UserProfile?
  roles                    UserRole[]
  UserTasks                UserTask[]
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  phone             String?
  language          String   @default("en")
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userRoles   UserRole[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Point {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  source    String
  sourceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String
  creatorId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
  creator     User        @relation(fields: [creatorId], references: [id])
  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  acquiredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  badge      Badge    @relation(fields: [badgeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model NFTDataAsset {
  id             String          @id @default(uuid())
  name           String
  description    String?
  metadata       Json
  ownerId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authorizations Authorization[]
  listings       Listing[]
  owner          User            @relation(fields: [ownerId], references: [id])
}

model Authorization {
  id          String       @id @default(uuid())
  assetId     String
  grantedTo   String
  permissions Json
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  asset       NFTDataAsset @relation(fields: [assetId], references: [id])
}

model AssetTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  amount      Float?
  assetId     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Activity {
  id                 String             @id @default(uuid())
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime?
  image              String?
  creatorId          String
  budget             Float?
  bidStrategy        Json?
  shareLink          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  equityDetails      String[]
  equityTitle        String?
  externalLinks      Json?
  externalLinksTitle String?
  nftDescription     String?
  nftImage           String?
  nftName            String?
  nftPrice           Float?
  nftTotalSupply     Int?
  nftUsageRules      String?
  nftValidityEnd     DateTime?
  nftValidityStart   DateTime?
  remaining          Int?
  showInExplore      Boolean            @default(true)
  statusNote         String?
  total              Int?
  type               String             @default("MEMBERSHIP")
  contractAddress    String?
  chainId            Int?
  tokenStandard      String?
  isPromoted         Boolean            @default(false)
  promotionInfo      Json?
  creator            User               @relation(fields: [creatorId], references: [id])
  claims             ActivityClaim[]
  dataDanceIDs       DataDanceID[]
  nftMarketOrders    NftMarketOrder[]
  snapshots          Snapshot[]
  categories         ActivityCategory[] @relation("ActivityToActivityCategory")
  tags               Tag[]              @relation("ActivityToTag")
}

model ActivityCategory {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToActivityCategory")
}

model Tag {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToTag")
  dataNFTs   DataNFT[]  @relation("DataNFTToTag")
  snapshots  Snapshot[] @relation("SnapshotToTag")
}

model ActivityClaim {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  status     String
  claimedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

model Listing {
  id        String       @id @default(uuid())
  assetId   String
  price     Float
  currency  String       @default("USD")
  status    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  asset     NFTDataAsset @relation(fields: [assetId], references: [id])
  orders    Order[]
}

model Order {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  status    String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model DataDanceID {
  id         String   @id @default(uuid())
  identifier String   @unique
  userId     String
  activityId String
  status     String   @default("ACTIVE")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

model CrawlerTask {
  id          String        @id @default(uuid())
  title       String
  description String?
  source      String
  status      String        @default("pending")
  recordCount Int           @default(0)
  dataUrl     String?
  log         String?
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  data        CrawlerData[]
  user        User          @relation(fields: [userId], references: [id])
}

model CrawlerData {
  id          String      @id @default(uuid())
  source      String
  type        String
  timestamp   DateTime
  metadata    Json
  payload     Json
  taskId      String
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contentHash String      @unique
  sourceId    String?
  task        CrawlerTask @relation(fields: [taskId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([userId, source, sourceId])
  @@index([userId, createdAt])
}

model Award {
  id          String      @id @default(uuid())
  title       String
  description String
  icon        String?
  color       String?
  status      AwardStatus @default(LOCKED)
  metadata    Json?       @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tasks       Task[]
  UserAwards  UserAward[]
}

model UserAward {
  id        String      @id @default(uuid())
  userId    String
  awardId   String
  status    AwardStatus @default(LOCKED)
  claimed   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Award     Award       @relation(fields: [awardId], references: [id])
  User      User        @relation(fields: [userId], references: [id])

  @@unique([userId, awardId])
}

model Task {
  id                 String      @id @default(uuid())
  awardId            String
  title              String
  description        String?
  status             AwardStatus @default(LOCKED)
  prerequisiteTaskId String?
  claimLimit         Int?
  requirementCount   Int?
  points             Int
  icon               String?
  picture            String?
  url                String?
  metadata           Json?       @default("{}")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  award              Award       @relation(fields: [awardId], references: [id])
  prerequisiteTask   Task?       @relation("TaskPrerequisite", fields: [prerequisiteTaskId], references: [id])
  dependentTasks     Task[]      @relation("TaskPrerequisite")
  UserTasks          UserTask[]
}

model UserTask {
  id           String      @id @default(uuid())
  userId       String
  taskId       String
  status       AwardStatus @default(LOCKED)
  claimRecords DateTime[]  @default(dbgenerated("(ARRAY[]::timestamp without time zone[])::timestamp(3) without time zone[]"))
  claimed      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  task         Task        @relation(fields: [taskId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@unique([userId, taskId])
}

model Referral {
  id        String   @id @default(uuid())
  inviterId String
  inviteeId String   @unique
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invitee   User     @relation("InvitesReceived", fields: [inviteeId], references: [id])
  inviter   User     @relation("InvitesSent", fields: [inviterId], references: [id])
}

model XPostCache {
  key       String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pass {
  id                 String   @id @default(uuid())
  creatorId          String
  creatorName        String
  creatorLogo        String
  userId             String
  userName           String
  userWalletAddress  String
  passUrl            String?
  status             String   @default("active")
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  pushToken          String?
  serialNumber       String?  @unique
  updatedAt          DateTime @updatedAt
  passTypeIdentifier String   @default("pass.ai.datadance.app")
  platform           String   @default("apple")
  googleObjectId     String?
  googleClassId      String?
  googleAddUrl       String?
  user               User     @relation(fields: [userId], references: [id])

  @@unique([userId, creatorId, platform])
  @@index([creatorId])
  @@index([userId])
}

enum AwardStatus {
  LOCKED
  LIVE
  INVALID
}

model NftMarketOrder {
  id          String   @id @default(uuid())
  userId      String
  activityId  String
  quantity    Int
  price       Float
  total       Float
  purchasedAt DateTime @default(now())
  activity    Activity @relation(fields: [activityId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([activityId])
}

model Snapshot {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String
  description String?
  activityId  String
  merchantId  String
  claims      Json?
  activity    Activity  @relation(fields: [activityId], references: [id])
  merchant    User      @relation(fields: [merchantId], references: [id])
  dataNFTs    DataNFT[] @relation("DataNFTToSnapshot")
  tags        Tag[]     @relation("SnapshotToTag")
}

model DataNFT {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  name         String
  description  String?
  price        Float
  isPublished  Boolean           @default(false)
  maxSales     Int               @default(1)
  currentSales Int               @default(0)
  merchantId   String
  image        String?
  merchant     User              @relation(fields: [merchantId], references: [id])
  purchases    DataNFTPurchase[]
  snapshots    Snapshot[]        @relation("DataNFTToSnapshot")
  tags         Tag[]             @relation("DataNFTToTag")
}

model DataNFTPurchase {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  dataNFTId String
  buyerId   String
  quantity  Int      @default(1)
  buyer     User     @relation(fields: [buyerId], references: [id])
  dataNFT   DataNFT  @relation(fields: [dataNFTId], references: [id])

  @@index([dataNFTId, buyerId])
}

model OrganizationTransaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String
  status      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}
