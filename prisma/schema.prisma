generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(uuid())
  
  // 基本信息
  email          String             @unique
  password       String?            // 现在密码可以为空，因为Web3Auth用户不需要密码
  name           String?
  avatar         String?
  
  // 区块链相关字段
  walletAddress  String?            @unique  // 用户的区块链钱包地址
  chainId        Int?               // 链 ID，例如以太坊主网是 1，Polygon 是 137
  privateKey     String?            // 钱包私钥，用于后端托管钱包
  
  // 认证和用户类型
  authType       String             @default("traditional") // "web3auth" 或 "traditional"
  userType       String             @default("regular")     // "regular" 或 "organization"
  
  // 组织相关字段
  isOrganization Boolean            @default(false)
  description    String?            // 组织描述
  logo           String?            // 组织标志（可以与avatar共用）
  
  // X (Twitter) 相关字段
  xid            String?            @unique // X (Twitter) User ID
  xUsername      String?            // X (Twitter) Username
  xAccessToken   String?            // Encrypt this if stored
  xRefreshToken  String?            // Encrypt this if stored
  
  // 邀请码 - 使用应用生成的 referralCode
  referralCode   String             @unique // 每个用户自己的推荐码，由应用生成
  
  // 时间戳
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  
  // 积分相关
  totalPoints    Float              @default(0)
  points         Point[]
  
  // 组织关系
  organizationId String?
  organization   User?              @relation("OrganizationMembers", fields: [organizationId], references: [id])
  members        User[]             @relation("OrganizationMembers")
  
  // 用户资料和角色
  profile        UserProfile?
  roles          UserRole[]
  
  // 活动和资产相关
  createdActivities Activity[]      // 创建的活动
  activityClaims    ActivityClaim[]
  dataAssets        NFTDataAsset[]  // 拥有的数据资产
  transactions      AssetTransaction[]
  
  // 徽章相关
  createdBadges   Badge[]           // 创建的徽章
  badges          UserBadge[]
  
  // 通知
  notifications   Notification[]
  
  // DataDance ID
  dataDanceIDs    DataDanceID[]
  
  // 奖励和任务相关
  UserAwards      UserAward[]
  UserTasks       UserTask[]
  
  // 邀请关系
  invitesSent     Referral[]        @relation("InvitesSent")
  invitesReceived Referral?         @relation("InvitesReceived")
  
  // Wallet Pass 关系
  passes          Pass[]
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  phone             String?
  language          String   @default("en")
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userRoles   UserRole[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       Role[]   @relation("PermissionToRole")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Point {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  source    String
  sourceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Badge {
  id             String       @id @default(uuid())
  name           String
  description    String?
  image          String
  creator        User         @relation(fields: [creatorId], references: [id])
  creatorId      String
  userBadges     UserBadge[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  acquiredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  badge      Badge    @relation(fields: [badgeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model NFTDataAsset {
  id             String          @id @default(uuid())
  name           String
  description    String?
  metadata       Json
  ownerId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authorizations Authorization[]
  listings       Listing[]
  owner          User            @relation(fields: [ownerId], references: [id])
}

model Authorization {
  id          String       @id @default(uuid())
  assetId     String
  grantedTo   String
  permissions Json
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  asset       NFTDataAsset @relation(fields: [assetId], references: [id])
}

model AssetTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  amount      Float?
  assetId     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Activity {
  id                 String             @id @default(uuid())
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime?
  image              String?
  creatorId          String
  budget             Float?
  bidStrategy        Json?
  shareLink          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  equityDetails      String[]
  equityTitle        String?
  externalLinks      Json?
  externalLinksTitle String?
  nftDescription     String?
  nftImage           String?
  nftName            String?
  nftPrice           Float?
  nftTotalSupply     Int?
  nftUsageRules      String?
  nftValidityEnd     DateTime?
  nftValidityStart   DateTime?
  remaining          Int?
  showInExplore      Boolean            @default(true)
  statusNote         String?
  total              Int?
  type               String             @default("MEMBERSHIP")
  contractAddress    String?
  chainId            Int?
  tokenStandard      String?
  creator            User               @relation(fields: [creatorId], references: [id])
  claims             ActivityClaim[]
  dataDanceIDs       DataDanceID[]
  categories         ActivityCategory[] @relation("ActivityToActivityCategory")
  tags               ActivityTag[]      @relation("ActivityToActivityTag")
}

model ActivityCategory {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToActivityCategory")
}

model ActivityTag {
  id         String     @id @default(uuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[] @relation("ActivityToActivityTag")
}

model ActivityClaim {
  id         String   @id @default(uuid())
  userId     String
  activityId String
  status     String
  claimedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

model Listing {
  id        String       @id @default(uuid())
  assetId   String
  price     Float
  currency  String       @default("USD")
  status    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  asset     NFTDataAsset @relation(fields: [assetId], references: [id])
  orders    Order[]
}

model Order {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  status    String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model DataDanceID {
  id         String   @id @default(uuid())
  identifier String   @unique
  userId     String
  activityId String
  status     String   @default("ACTIVE")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
}

// Award相关模型
model Award {
  id          String      @id @default(uuid()) // 奖励唯一标识
  title       String      // 奖励标题
  description String      // 奖励描述
  icon        String?     // 前端图标名
  color       String?     // 前端展示颜色
  status      AwardStatus @default(LOCKED) // 全局奖励状态：LOCKED/ LIVE/ INVALID
  metadata    Json?       @default("{}") // 可选元数据
  tasks       Task[]      // 子任务列表
  UserAwards  UserAward[] // 用户奖励关联表
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// 用户奖励状态和领取记录
model UserAward {
  id        String      @id @default(uuid()) // 记录唯一标识
  userId    String      // 用户 ID
  awardId   String      // 奖励 ID
  status    AwardStatus @default(LOCKED) // 此用户此奖励的状态
  claimed   Boolean     @default(false)  // 是否已领取过
  createdAt DateTime    @default(now())  // 记录创建时间
  updatedAt DateTime    @updatedAt
  
  User      User        @relation(fields: [userId], references: [id])
  Award     Award       @relation(fields: [awardId], references: [id])
  
  @@unique([userId, awardId])
}

// 全局奖励三态：锁定、开放、失效
enum AwardStatus {
  LOCKED   // 未发布或前置未达成
  LIVE     // 正常开放
  INVALID  // 已过期或灰度外
}

// Global status states for awards and tasks
// LOCKED: not available; LIVE: active; INVALID: expired or inaccessible
// Reuse AwardStatus enum for tasks as well

model Task {
  id                String      @id @default(uuid())
  award             Award       @relation(fields: [awardId], references: [id])
  awardId           String
  title             String      // Task title
  description       String?     // Task description
  status            AwardStatus @default(LOCKED) // Task status: LOCKED/LIVE/INVALID
  prerequisiteTaskId String?    // Optional ID of a prerequisite task for unlocking this one
  prerequisiteTask   Task?      @relation("TaskPrerequisite", fields: [prerequisiteTaskId], references: [id])
  claimLimit        Int?        // Max claims for CONTINUOUS tasks, null = unlimited
  requirementCount  Int?        // Optional numeric requirement for progress
  points            Int         // Reward points per completion
  icon              String?     // Optional icon name
  picture           String?     // Optional image URL
  url               String?     // Optional action link
  metadata          Json?       @default("{}") // Optional metadata
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  UserTasks         UserTask[]
  dependentTasks    Task[]      @relation("TaskPrerequisite")
}

model UserTask {
  id            String      @id @default(uuid())
  userId        String
  taskId        String
  status        AwardStatus @default(LOCKED) // User task status: LOCKED/LIVE/INVALID
  claimRecords  DateTime[]  @default([]) // Timestamps of each claim
  claimed       Boolean     @default(false)  // whether user has claimed reward
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  user          User        @relation(fields: [userId], references: [id])
  task          Task        @relation(fields: [taskId], references: [id])
  
  @@unique([userId, taskId])
}

// 多级邀请关系表
model Referral {
  id         String   @id @default(uuid())
  inviterId  String
  inviteeId  String   @unique
  code       String   // 实际使用的邀请码字符串
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  inviter    User     @relation("InvitesSent", fields: [inviterId], references: [id])
  invitee    User     @relation("InvitesReceived", fields: [inviteeId], references: [id])
}

// Add persistent cache for X post engagement data
model XPostCache {
  key       String   @id        // e.g. 'retweets:<postId>' or 'quotes:<query>'
  data      Json               // stored API response data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Wallet Pass模型
model Pass {
  id                String   @id @default(uuid())
  creatorId         String
  creatorName       String
  creatorLogo       String
  userId            String
  userName          String
  userWalletAddress String
  passUrl           String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  serialNumber      String?  @unique
  pushToken         String?
  updatedAt         DateTime @updatedAt
  passTypeIdentifier String  @default("pass.ai.datadance.app")
  platform          String   @default("apple")
  googleObjectId    String?
  googleClassId     String?
  googleAddUrl      String?
  
  // 关系
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, creatorId, platform])
  @@index([creatorId])
  @@index([userId])
}
