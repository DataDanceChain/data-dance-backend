// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户相关模型
model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String?            // 现在密码可以为空，因为Web3Auth用户不需要密码
  name           String?
  avatar         String?
  
  // 区块链相关字段
  walletAddress  String?            @unique  // 用户的区块链钱包地址
  chainId        Int?               // 链 ID，例如以太坊主网是 1，Polygon 是 137
  privateKey     String?            // 钱包私钥，用于后端托管钱包
  
  // 认证和用户类型
  authType       String             @default("traditional") // "web3auth" 或 "traditional"
  userType       String             @default("regular")     // "regular" 或 "organization"
  
  // 组织相关字段
  isOrganization Boolean            @default(false)
  description    String?            // 组织描述
  logo           String?            // 组织标志（可以与avatar共用）
  
  // 关系
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  profile        UserProfile?
  totalPoints    Float              @default(0)
  points         Point[]
  badges         UserBadge[]
  activityClaims ActivityClaim[]
  notifications  Notification[]
  transactions   AssetTransaction[]
  roles          UserRole[]
 inviteCode String  @unique @default(uuid())
  
  // 原来从Organization迁移过来的关系
  createdActivities Activity[]      // 创建的活动
  dataAssets      NFTDataAsset[]    // 拥有的数据资产
  createdBadges   Badge[]           // 创建的徽章
  members         User[]            @relation("OrganizationMembers") // 组织成员
  organization    User?             @relation("OrganizationMembers", fields: [organizationId], references: [id]) // 所属组织
  organizationId  String?

  // 添加关系
  dataDanceIDs   DataDanceID[]
  UserAwards     UserAward[]
  invitesSent    Referral[]         @relation("InvitesSent")
  invitesReceived Referral?         @relation("InvitesReceived")
  UserTasks      UserTask[]
}

model UserProfile {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id])
  userId            String   @unique
  phone             String?
  language          String   @default("en")
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  permissions Permission[]
  userRoles   UserRole[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
}

model Permission {
  id          String   @id @default(uuid())
  name        String
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model UserRole {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@id([userId, roleId])
}

// 资产相关模型
model Point {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  amount    Float
  source    String
  sourceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Badge {
  id             String       @id @default(uuid())
  name           String
  description    String?
  image          String
  creator        User         @relation(fields: [creatorId], references: [id])
  creatorId      String
  userBadges     UserBadge[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model UserBadge {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  badgeId    String
  acquiredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, badgeId])
}

model NFTDataAsset {
  id             String          @id @default(uuid())
  name           String
  description    String?
  metadata       Json
  owner          User            @relation(fields: [ownerId], references: [id])
  ownerId        String
  authorizations Authorization[]
  listings       Listing[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Authorization {
  id          String       @id @default(uuid())
  asset       NFTDataAsset @relation(fields: [assetId], references: [id])
  assetId     String
  grantedTo   String
  permissions Json
  validFrom   DateTime
  validTo     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
}

model AssetTransaction {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  type        String // POINT_EARNED, POINT_SPENT, BADGE_ACQUIRED, etc.
  amount      Float?
  assetId     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

// 活动相关模型
model Activity {
  id             String             @id @default(uuid())
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  image          String?
  creator        User               @relation(fields: [creatorId], references: [id])
  creatorId      String
  categories     ActivityCategory[]
  tags           ActivityTag[]
  claims         ActivityClaim[]
  budget         Float?
  bidStrategy    Json?
  shareLink      String?
  
  // 活动类型和状态
  type           String             @default("MEMBERSHIP") // MEMBERSHIP 或 REDEMPTION
  remaining      Int?               // 剩余数量
  total          Int?               // 总数量
  statusNote     String?            // 状态说明
  
  // 权益与福利
  equityTitle    String?            // 权益标题
  equityDetails  String[]           // 权益详情列表
  
  // 外部链接
  externalLinksTitle String?        // 外部链接标题
  externalLinks  Json?              // 外部链接列表
  
  // NFT 相关信息
  nftName        String?            // NFT 名称
  nftDescription String?            // NFT 描述
  nftImage       String?            // NFT 图片
  nftTotalSupply Int?               // NFT 总供应量
  nftPrice       Float?             // NFT 价格
  nftValidityStart DateTime?        // NFT 有效期开始
  nftValidityEnd DateTime?          // NFT 有效期结束
  nftUsageRules  String?            // NFT 使用规则
  
  // 区块链相关字段
  contractAddress String?           // 链上合约地址
  chainId        Int?               // 链 ID，例如以太坊主网是 1，Polygon 是 137
  tokenStandard  String?            // 代币标准，如 ERC721, ERC1155
  
  showInExplore  Boolean            @default(true) // 是否在探索页显示
  
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  
  // 添加关系
  dataDanceIDs   DataDanceID[]
}

model ActivityCategory {
  id         String     @id @default(uuid())
  name       String
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now())
}

model ActivityTag {
  id         String     @id @default(uuid())
  name       String
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now())
}

model ActivityClaim {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  activity  Activity @relation(fields: [activityId], references: [id])
  activityId String
  status    String   // CLAIMED, COMPLETED, etc.
  claimedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, activityId])
}

// 市场相关模型
model Listing {
  id        String       @id @default(uuid())
  asset     NFTDataAsset @relation(fields: [assetId], references: [id])
  assetId   String
  price     Float
  currency  String       @default("USD")
  status    String // ACTIVE, SOLD, CANCELLED
  orders    Order[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now())
}

model Order {
  id        String   @id @default(uuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  buyerId   String
  status    String // PENDING, COMPLETED, CANCELLED
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// 通知相关模型
model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  content   String
  type      String // SYSTEM, ACTIVITY, TRANSACTION
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// DataDanceID 模型 - 用户参与活动时生成的唯一标识
model DataDanceID {
  id            String    @id @default(uuid())
  identifier    String    @unique // 生成的唯一标识符
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  activity      Activity  @relation(fields: [activityId], references: [id])
  activityId    String
  status        String    @default("ACTIVE") // ACTIVE, REVOKED
  metadata      Json?     // 可以存储额外的元数据
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // 确保用户和活动的组合是唯一的
  @@unique([userId, activityId])
}

// Award相关模型
model Award {
  id          String      @id @default(uuid()) // 奖励唯一标识
  title       String      // 奖励标题
  description String      // 奖励描述
  icon        String?     // 前端图标名
  color       String?     // 前端展示颜色
  status      AwardStatus @default(LOCKED) // 全局奖励状态：LOCKED/ LIVE/ INVALID
  metadata    Json?       @default("{}") // 可选元数据
  tasks       Task[]      // 子任务列表
  UserAwards  UserAward[] // 用户奖励关联表
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
}

// 用户奖励状态和领取记录
model UserAward {
  id        String      @id @default(uuid()) // 记录唯一标识
  userId    String      // 用户 ID
  awardId   String      // 奖励 ID
  status    AwardStatus @default(LOCKED) // 此用户此奖励的状态
  claimed   Boolean     @default(false)  // 是否已领取过
  createdAt DateTime    @default(now())  // 记录创建时间
  @@unique([userId, awardId])
  User      User        @relation(fields: [userId], references: [id])
  Award     Award       @relation(fields: [awardId], references: [id])
}

// 全局奖励三态：锁定、开放、失效
enum AwardStatus {
  LOCKED   // 未发布或前置未达成
  LIVE     // 正常开放
  INVALID  // 已过期或灰度外
}

// Global status states for awards and tasks
// LOCKED: not available; LIVE: active; INVALID: expired or inaccessible
// Reuse AwardStatus enum for tasks as well

model Task {
  id           String      @id @default(uuid())
  award        Award       @relation(fields: [awardId], references: [id])
  awardId      String
  title        String      // Task title
  description  String?     // Task description
  status        AwardStatus @default(LOCKED) // Task status: LOCKED/LIVE/INVALID
  prerequisiteTaskId String? // Optional ID of a prerequisite task for unlocking this one
  prerequisiteTask   Task?   @relation("TaskPrerequisite", fields: [prerequisiteTaskId], references: [id])
  claimLimit    Int?        // Max claims for CONTINUOUS tasks, null = unlimited
  points        Int         // Reward points per completion
  icon          String?     // Optional icon name
  picture       String?     // Optional image URL
  url           String?     // Optional action link
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now())
  UserTasks     UserTask[]
  dependentTasks Task[]   @relation("TaskPrerequisite")
}

model UserTask {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  task          Task        @relation(fields: [taskId], references: [id])
  taskId        String
  status        AwardStatus @default(LOCKED) // User task status: LOCKED/LIVE/INVALID
  claimRecords  DateTime[]  @default([]) // Timestamps of each claim; count = length of this array
  claimed       Boolean     @default(false)  // whether user has claimed reward
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now())
  @@unique([userId, taskId])
}

// 多级邀请关系表
model Referral {
  id         String   @id @default(uuid())
  inviter    User     @relation("InvitesSent", fields: [inviterId], references: [id])
  inviterId  String
  invitee    User     @relation("InvitesReceived", fields: [inviteeId], references: [id])
  inviteeId  String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
}